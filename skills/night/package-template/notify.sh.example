#!/bin/bash
# Хук уведомления: run.sh зовёт `bash night/notify.sh "<текст>"` при провале старта,
# остановке ночи и готовой сводке. Переименуй в notify.sh, сделай chmod +x.
# Пример — Telegram: токен бота и chat_id из переменных окружения, не из файла в репо.
[ -n "${NIGHT_TG_TOKEN:-}" ] && [ -n "${NIGHT_TG_CHAT:-}" ] || { echo "notify: NIGHT_TG_TOKEN/NIGHT_TG_CHAT не заданы" >&2; exit 1; }
curl -fsS -m 15 "https://api.telegram.org/bot${NIGHT_TG_TOKEN}/sendMessage" \
  --data-urlencode "chat_id=${NIGHT_TG_CHAT}" --data-urlencode "text=$1" > /dev/null
