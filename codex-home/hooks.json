{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "'__HOME__/.codex/hooks/warn-before-push.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "'__HOME__/.codex/hooks/post-edit-syntax-check.sh'",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 '__HOME__/.codex/hooks/drift-markers.py'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
